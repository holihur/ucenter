# ── UCenter server ────────────────────────────────────────────────────────────
ADDR=:8080
# Allow public POST /api/public/signup (self-service tenant creation).
ALLOW_SELF_SIGNUP=true
# Public origin used in issuer URLs and OIDC discovery documents.
BASE_URL=http://localhost:8080

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=ucenter

# Directory containing the built SPA (relative to the server working directory).
WEB_DIR=../web/dist

# Cookies: set to true whenever the app is served over HTTPS.
COOKIE_SECURE=false
COOKIE_NAME=uc_session

# Development mode enables Gin request logging.
DEV=false

# Comma-separated CORS origins. Leave empty when the SPA is served by this server
# or proxied through Vite (same-origin).
ALLOWED_ORIGINS=

# Comma-separated proxy IPs trusted for X-Forwarded-For. Empty = trust none.
# Set this to your reverse proxy address in production (e.g. 127.0.0.1).
TRUSTED_PROXIES=

# Optional first-run bootstrap. Creates a platform administrator and, when
# BOOTSTRAP_TENANT_SLUG is set, a tenant owned by that administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=

# 32-byte master key used to encrypt signing PEMs and client-secret copies at rest.
# Generate once with: openssl rand -base64 32
# Keep it stable: changing it makes existing encrypted secrets unreadable.
ENCRYPTION_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# mock stores messages in MongoDB (mail_outbox) and is ideal for local dev.
# smtp sends through a real SMTP server.
MAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ucenter.local
SMTP_FROM_NAME=UCenter
# true for implicit TLS (usually port 465); false uses STARTTLS when available.
SMTP_TLS=false

# Optional Redis for shared rate limiting across replicas.
# Example: redis://127.0.0.1:6379/0
REDIS_URL=
REDIS_PREFIX=ucenter:rl:

# WebAuthn relying party. Defaults to the hostname of BASE_URL.
# For local development use BASE_URL=http://localhost:8080 and RP_ID=localhost.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# Protect /metrics with a bearer token (leave empty on a private network).
METRICS_TOKEN=
# text or json (defaults to text in DEV, json otherwise)
LOG_FORMAT=
LOG_LEVEL=info

# ── Frontend (Vite dev server only) ───────────────────────────────────────────
# Backend target for the Vite proxy. Defaults to http://localhost:8080.
VITE_API_TARGET=http://localhost:8080
